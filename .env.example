# ─── Required ────────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, CMS webhooks, and API endpoints.
# Example: http://localhost:5173 (dev) or https://ecosmarthomes.ie (production)
APP_URL="MY_APP_URL"

# NODE_ENV: Environment mode. Controls error handling, Sentry environment,
# and feature flags. Must be one of: development, production, test.
NODE_ENV="development"

# ─── AI & Content Generation ─────────────────────────────────────────────────

# VITE_GEMINI_API_KEY: Alternative client-side Gemini API key.
# The server checks process.env.GEMINI_API_KEY || process.env.VITE_GEMINI_API_KEY.
# Set this if you need the key available in the Vite client bundle.
VITE_GEMINI_API_KEY="MY_VITE_GEMINI_API_KEY"

# ─── Error Monitoring ────────────────────────────────────────────────────────

# SENTRY_DSN: Server-side Sentry DSN for @sentry/node error monitoring.
# Optional but recommended for production. Capture and report Express errors.
SENTRY_DSN="MY_SENTRY_DSN"

# VITE_SENTRY_DSN: Client-side Sentry DSN for @sentry/react error monitoring.
# Vite exposes env vars prefixed with VITE_ to the client bundle.
# Optional. If set, the React app will initialize Sentry with this DSN.
VITE_SENTRY_DSN="MY_VITE_SENTRY_DSN"

# ─── Rate Limiting ───────────────────────────────────────────────────────────

# RATE_LIMIT_MAX: Maximum number of requests per window for API routes.
# Only enforced in production. Defaults to 100.
RATE_LIMIT_MAX="100"

# RATE_LIMIT_WINDOW_MS: Time window (in milliseconds) for rate limiting.
# Defaults to 900000 (15 minutes).
RATE_LIMIT_WINDOW_MS="900000"

# ─── Development ─────────────────────────────────────────────────────────────

# DISABLE_HMR: Set to "true" to disable Hot Module Replacement during agent edits.
# Reduces CPU usage and prevents flickering when AI agents modify files.
# Only applicable in development.
DISABLE_HMR="false"

# VERCEL: Indicates the app is running in the Vercel serverless environment.
# Automatically set by Vercel. Do not set manually.
VERCEL=""
