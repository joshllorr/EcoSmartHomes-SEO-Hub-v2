    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "cron-parser": "^5.7.0",
    "glob": "^13.0.6"
  },
  "lavamoat": {
    "allowScripts": {
      "@google/genai#2.16.0": false,
      "@google/genai>protobufjs#7.6.5": false,
      "@vercel/node>esbuild#0.27.0": false,
      "esbuild#0.28.2": false,
      "jspdf>core-js#3.50.0": false
    }
  }
}
